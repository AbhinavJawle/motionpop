rules_version = '2';
// Owner-only. Limits mirror steering security-and-cost.md: audio <= 50 MB, images <= 10 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/audio/{file=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource != null
        && request.resource.contentType.matches('audio/.*')
        && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/video/{file=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource != null
        && request.resource.contentType.matches('(video|image)/.*')
        && request.resource.size <= 500 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/brand/{file=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/media/{file=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    // Written by the render service account only.
    match /users/{uid}/projects/{pid}/renders/{file=**} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
