# Copy to apps/web/.env.local and fill in. Names only here; never commit values.
# Get the web config with: npx -y firebase-tools@latest apps:sdkconfig WEB <appId>

# Firebase web config (public by design; protection is App Check + security rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App Check: reCAPTCHA Enterprise site key (public)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# App Check debug token registered in the console (development builds only; private)
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# AI Logic backend: vertex (default, per-call billing on Blaze) or google (Gemini Developer API, prepaid)
NEXT_PUBLIC_AI_BACKEND=

# Set to true to use the local Emulator Suite (pnpm emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# Local dev cloud profile switcher (managed by `pnpm cloud:use personal|lab`; never set in prod)
NEXT_PUBLIC_CLOUD_PROFILE=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Server only (App Hosting reads these from Secret Manager in production)
JUDGE_EMAILS=
ANTHROPIC_API_KEY=
# Royalty-free stock B-roll & photos (https://pixabay.com/api/docs/ and https://www.pexels.com/api/)
PIXABAY_API_KEY=
PEXELS_API_KEY=
# Creative Commons music & SFX search in the Audio tab (https://uncommonear.com/docs/api)
UNCOMMON_EAR_API_KEY=

# Dodo Payments credit packs (spec 44; server-only — never prefix with NEXT_PUBLIC_)
# Defaults to test_mode unless explicitly set to "live_mode".
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_RETURN_URL=
DODO_PRODUCT_STARTER_ID=
DODO_PRODUCT_CREATOR_ID=
DODO_PRODUCT_STUDIO_ID=
# Optional canonical public origin (e.g. https://motionpop.app) used for checkout return_url fallback
NEXT_PUBLIC_APP_URL=
