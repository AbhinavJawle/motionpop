{
  // Pireel's own compiler settings (from its root tsconfig at 51fb487), so its code is checked as
  // its authors wrote it. Motionpop's app references this project and reads only the emitted
  // declarations, which keeps our stricter settings (noUncheckedIndexedAccess) for our own code.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".types",
    // pnpm keeps type packages beside the packages that declare them.
    "typeRoots": ["./studio-engine/node_modules/@types", "./ui/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*/src/**/*.ts", "*/src/**/*.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/node_modules"]
}
