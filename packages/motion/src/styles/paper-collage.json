{
  "id": "paper-collage",
  "name": "Paper Collage",
  "tagline": "A little rough. Full of character.",
  "tags": ["Playful", "Explainer"],
  "description": "Kraft paper, torn cream and coral strips, tape, cut-out words and a stop-motion step.",
  "colors": {
    "bg": "#DFCDB7",
    "ink": "#1F1A17",
    "muted": "#5F4C40",
    "accent": "#D96648",
    "accent2": "#5E7F6A",
    "highlight": "#F7F0D8",
    "positive": "#3F6B4A",
    "negative": "#A63A22",
    "chart": ["#C2AE93", "#8C735E", "#D96648"]
  },
  "fonts": {
    "display": "Geist",
    "body": "Geist",
    "mono": "Geist Mono",
    "displayWeight": 600
  },
  "texture": { "grain": 0.07, "paper": true, "vignette": 0.1 },
  "motion": {
    "enterEase": "outQuart",
    "moveEase": "inOutCubic",
    "enterMs": 560,
    "staggerMs": 60,
    "holdMs": 1000,
    "camera": { "pushIn": 1.03 }
  },
  "shape": { "radius": 0, "stroke": 3 },
  "allowPlayful": false,
  "energy": "lively",
  "personality": {
    "preset": "stepped",
    "enter": { "text": "slam", "number": "count", "shape": "pop" },
    "overshoot": 0.04,
    "popMax": 0.06,
    "exitRatio": 0.6,
    "stepFps": 12,
    "snapMargin": 15
  },
  "camera": { "push": [1, 1.03], "snap": 0, "whip": false, "parallax": 18 },
  "surfaces": {
    "card": ["paper", "torn-edge", "shadow-soft", "tape", "tilt"],
    "photo": ["white-border", "tape", "tilt", "shadow-soft"],
    "label": ["plain"],
    "strip": ["torn-edge", "shadow-soft", "tilt"]
  },
  "marks": {
    "emphasis": "cutout",
    "pointer": "marker-arrow",
    "divider": "torn-rule",
    "badge": "stamp"
  },
  "juice": ["camera-push", "parallax-shift", "decor-draw"],
  "image": {
    "recipe": "{subject}, vintage 1970s magazine photo cut-out, visible halftone print dots, slightly faded warm colours",
    "treatment": ["key", "white-border", "tilt", "tape"]
  },
  "sound": { "enter": "paper", "mark": "paper", "focal": "thud", "snap": "whoosh" },
  "transitions": ["paper-wipe", "push"]
}
