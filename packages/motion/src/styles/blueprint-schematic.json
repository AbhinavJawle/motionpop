{
  "id": "blueprint-schematic",
  "name": "Blueprint Schematic",
  "tagline": "Drafting navy, vector precision & system diagrams.",
  "tags": ["Technical", "Explainer"],
  "description": "Architectural drafting plates and 3Blue1Brown visual mechanisms: deep blueprint navy, crisp white technical hairlines, cyan vector traces, and calm precision.",
  "colors": {
    "bg": "#0C1B33",
    "ink": "#F8FAFC",
    "muted": "#93B4D8",
    "accent": "#38BDF8",
    "accent2": "#FBBF24",
    "highlight": "#38BDF8",
    "positive": "#34D399",
    "negative": "#F87171",
    "chart": ["#4A6FA5", "#FBBF24", "#38BDF8"]
  },
  "fonts": {
    "display": "Geist",
    "body": "Geist",
    "mono": "Geist Mono",
    "displayWeight": 600
  },
  "texture": {
    "grain": 0.02,
    "paper": false,
    "vignette": 0.12
  },
  "motion": {
    "enterEase": "outQuart",
    "moveEase": "inOutCubic",
    "enterMs": 480,
    "staggerMs": 55,
    "holdMs": 1150,
    "camera": {
      "pushIn": 1.03
    }
  },
  "shape": {
    "radius": 4,
    "stroke": 1.5
