    "enter": {
      "text": "mask",
      "number": "count",
      "shape": "draw"
    },
    "overshoot": 0.02,
    "popMax": 0.04,
    "exitRatio": 0.6,
    "snapMargin": 12
  },
  "camera": {
    "push": [1, 1.03],
    "snap": 0,
    "whip": false,
    "parallax": 12
  },
  "surfaces": {
    "card": ["plain", "grid"],
    "photo": ["white-border"],
    "label": ["plain"],
    "strip": ["plain"]
  },
  "marks": {
    "emphasis": "underline",
    "pointer": "arrow",
    "divider": "rule",
    "badge": "chip"
  },
  "juice": ["camera-push", "decor-draw"],
  "image": {
    "recipe": "Crisp isometric architectural blueprint and technical vector schematic illustration of {subject}, clean cyan and ink linework, isolated cleanly on pure white background, no text, no watermark",
    "treatment": ["key"]
  },
  "sound": {
    "enter": "whoosh",
    "mark": "pen",
    "focal": "thud",
    "snap": "whoosh"
  },
  "transitions": ["push"],
  "map": {
    "style": "night"
