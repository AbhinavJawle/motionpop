{
  "name": "@motionpop/motion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./compiler": "./src/compiler/index.ts",
    "./reel": "./src/reel/index.ts",
    "./styles": "./src/styles/index.ts",
    "./registry": "./src/registry.ts",
    "./sfx": "./src/sfx/index.ts",
    "./sfx/wav": "./src/sfx/wav.ts",
    "./testing/project-fixture": "./src/testing/project-fixture.ts",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build:runtime": "node scripts/build-runtime.ts",
    "motion:check": "node scripts/build-runtime.ts && node scripts/run-check.ts",
    "sfx:listen": "node scripts/sfx-listen.ts",
    "sheet": "node scripts/build-runtime.ts && node scripts/run-sheet.ts",
    "film:lab": "node scripts/build-runtime.ts && node scripts/run-film-lab.ts"
  },
  "dependencies": {
    "@motionpop/schemas": "workspace:*",
    "d3-geo": "3.1.1",
    "perfect-freehand": "1.2.3",
    "roughjs": "4.6.6",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hyperframes/core": "catalog:",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "catalog:",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "d3": "7.9.0",
    "esbuild": "^0.28.2",
    "fast-check": "catalog:",
    "flubber": "0.4.2",
    "happy-dom": "^21.0.4",
    "katex": "0.16.11",
    "puppeteer": "~25.13.0",
    "three": "0.159.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
